// totem -- generated from its matrix_transform. 38 keys.
// LAYOUT() takes the canonical 46 slots and keeps the 38 this board has.

#define LAYOUT( \
    l1, l2, l3, l4, l5, \
    r1, r2, r3, r4, r5, \
    l6, l7, l8, l9, l10, \
    r6, r7, r8, r9, r10, \
    l11, l12, l13, l14, l15, \
    r11, r12, r13, r14, r15, \
    lt1, lt2, lt3, rt1, rt2, \
    rt3, o1l, o1r, o2l, o2r, \
    o3l, o3r, midl, midr, t4l, \
    t4r)  \
      l1   l2   l3   l4   l5   r1   r2   r3   r4   r5 \
      l6   l7   l8   l9  l10   r6   r7   r8   r9  r10 \
     o3l  l11  l12  l13  l14  l15  r11  r12  r13  r14  r15  o3r \
     lt1  lt2  lt3  rt1  rt2  rt3

// hands, for hold-trigger-key-positions (cols 0-4 = left, 5+ = right)
#define KEYS_L 0 1 2 3 4 10 11 12 13 14 \
               20 21 22 23 24 25 32 33 34
#define KEYS_R 5 6 7 8 9 15 16 17 18 19 \
               26 27 28 29 30 31 35 36 37

// key positions by canonical slot, for combos
#define POS_L1    0
#define POS_L2    1
#define POS_L3    2
#define POS_L4    3
#define POS_L5    4
#define POS_R1    5
#define POS_R2    6
#define POS_R3    7
#define POS_R4    8
#define POS_R5    9
#define POS_L6    10
#define POS_L7    11
#define POS_L8    12
#define POS_L9    13
#define POS_L10   14
#define POS_R6    15
#define POS_R7    16
#define POS_R8    17
#define POS_R9    18
#define POS_R10   19
#define POS_L11   21
#define POS_L12   22
#define POS_L13   23
#define POS_L14   24
#define POS_L15   25
#define POS_R11   26
#define POS_R12   27
#define POS_R13   28
#define POS_R14   29
#define POS_R15   30
#define POS_LT1   32
